# Copy to .env on the server. Never commit .env.
OVERLORD_ADMIN_TOKEN=change-me-to-a-long-random-string
# Composio: API key from the Composio dashboard; the YouTube channel is connected there once.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_YOUTUBE_ACCOUNT_ID=
# Optional: Claude for semantic clip judgement and metadata. Without it, heuristic scoring + extractive metadata.
ANTHROPIC_API_KEY=
OVERLORD_LLM_MODEL=claude-opus-5-5
# Transcription model: small (fast, CPU) or large-v3 (best for Hindi/Hinglish, ~3x slower)
OVERLORD_WHISPER_MODEL=small
